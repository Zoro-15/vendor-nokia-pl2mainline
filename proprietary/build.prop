#
# Vendor Build Properties for Nokia 6.1 (PL2) Mainline
# Target: Slot B ONLY | LineageOS 24.0 / Treble GSI
#

# Device Identity
ro.hardware=nokia-pl2
ro.product.vendor.brand=Nokia
ro.product.vendor.device=PL2_mainline
ro.product.vendor.manufacturer=HMD Global
ro.product.vendor.model=Nokia 6.1
ro.product.vendor.name=lineage_PL2_mainline
bluetooth.device.default_name=Nokia 6.1
ro.hardware.fingerprint=elan

# Mandatory Qualcomm Adreno 508 / A5xx Workarounds (docs/qcom/GRAPHICS.md)
# Prevents UBWC corruption and sysmem allocator deadlocks on retail SDM630
vendor.mesa.fd.mesa.debug=sysmem
vendor.minigbm.avoid_ubwc=true
ro.hardware.egl=mesa

# Treble & System Integrity
ro.treble.enabled=true
ro.vendor.build.security_patch=2026-10-01
ro.vendor.build.type=userdebug
ro.vendor.build.tags=test-keys
ro.vendor.build.version.incremental=20261030

# USB Gadget Controller
sys.usb.controller=a800000.usb
vendor.usb.controller=a800000.usb

# Graphics, Gralloc & SurfaceFlinger Properties
ro.hardware.gralloc=minigbm
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.has_wide_color_display=false
ro.surface_flinger.has_HDR_display=false
ro.surface_flinger.use_color_management=false
ro.sf.lcd_density=420

# Recovery UI Properties
ro.recovery.ui.blank_unblank_on_init=true



