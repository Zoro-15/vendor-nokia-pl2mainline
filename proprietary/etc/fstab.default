# Android fstab file for Nokia 6.1 (PL2) Mainline
# Repurposes the OEM logdump partition (mmcblk1p79) as /metadata for aconfigd

/dev/block/by-name/system                /system               ext4   ro,barrier=1,discard                             wait,slotselect,first_stage_mount
/dev/block/by-name/vendor                /vendor               ext4   ro,barrier=1,discard                             wait,slotselect,first_stage_mount
/dev/block/by-name/logdump               /metadata             ext4   nosuid,nodev,noatime,discard                     wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata              /data                 ext4   noatime,nosuid,nodev,barrier=1,discard,errors=panic wait,check,latemount,formattable,quota
/dev/block/by-name/misc                  /misc                 emmc   defaults                                         defaults

