;; Mainline Minimal Allow Rules (Slot B Bringup)
;; =========================================================================
(type vendor_init)
(typeattributeset domain (vendor_init))

;; apexd vendor access for bootstrap
(allow apexd_202604 unlabeled_202604 (dir (open read getattr search)))
(allow apexd_202604 vendor_file_202604 (dir (open read getattr search)))
(allow apexd_202604 vendor_file_202604 (file (read getattr open)))

