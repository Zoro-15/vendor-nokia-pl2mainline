#
# Init script for Nokia 6.1 (PL2) Mainline
#

on early-init
    # Set up bootdevice symlink for mainline eMMC controller
    wait /dev/block/platform/soc@0/c0c4000.mmc 1
    symlink /dev/block/platform/soc@0/c0c4000.mmc /dev/block/bootdevice
    symlink /dev/block/platform/soc@0/c0c4000.mmc /dev/block/platform/soc/c0c4000.sdhci

on fs
    # Mount first-stage partitions
    mount_all /vendor/etc/fstab.nokia-pl2 --early

on late-fs
    # Mount userdata & late-mount partitions
    mount_all /vendor/etc/fstab.nokia-pl2 --late

on init
    # Configure USB gadget controller (DWC3 on SDM630)
    setprop sys.usb.controller a800000.dwc3

on boot
    # Permissions for DRM render nodes & Goodix touch
    chmod 0666 /dev/dri/card0
    chmod 0666 /dev/dri/renderD128
    chmod 0660 /dev/input/event0
    chown system input /dev/input/event0

