# Firmware directories for Nokia 6.1 Mainline
firmware_directories /vendor/firmware/ /vendor/firmware/qcom/ /odm/firmware/ /firmware/image/ /vendor/firmware_mnt/image/ /vendor/firmware_mnt/ /vendor/bt_firmware/image/
modalias_handling enabled

# DRM / KMS Graphics (Adreno 508 / freedreno / card0)
/dev/dri/*                0666   system     graphics
/dev/graphics/*           0660   root       graphics

# DMA-BUF Heaps (Gralloc / minigbm)
/dev/dma_heap/*           0664   system     system
/dev/dma_heap/system      0664   system     system
/dev/dma_heap/system-uncached 0664 system   system

# BinderFS / Binder IPC
/dev/binderfs/*           0666   root       root
/dev/binderfs/binder      0666   root       root
/dev/binderfs/hwbinder    0666   root       root
/dev/binderfs/vndbinder   0666   root       root
/dev/binder               0666   root       root
/dev/hwbinder             0666   root       root
/dev/vndbinder            0666   root       root

# Input Subsystem (Goodix GT1152 Digitizer)
/dev/input/event*         0660   system     input

# Hardware Crypto (QCE) & Hardware Random Number Generator (QCOM RNG)
/dev/qce                  0660   system     drmrpc
/dev/hwrng                0440   root       system

# Fingerprint Sensor
/dev/elan_fp              0660   system     system
/dev/goodix_fp            0660   system     system
